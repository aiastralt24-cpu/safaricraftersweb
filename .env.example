NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_WRITE_TOKEN=
NEXT_PUBLIC_HERO_VIDEO_MP4=
NEXT_PUBLIC_HERO_VIDEO_WEBM=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Independent CMS staging (separate from legacy enquiry storage).
# Use the public anon/publishable key here, NEVER a service-role key.
CMS_SUPABASE_URL=
CMS_SUPABASE_ANON_KEY=
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=Safari Crafters <briefs@example.com>
# Comma-separated team recipients
ENQUIRY_TO_EMAIL=
ADMIN_TOKEN=
# Server-only scheduled notification retry endpoint authentication
CRON_SECRET=
# Set to sanity only after reconciling the published dataset; otherwise Git snapshot
SAFARI_CONTENT_SOURCE=snapshot
SANITY_READ_TOKEN=
# Enable only after the event table, retention and privacy review are configured
NEXT_PUBLIC_FUNNEL_ENABLED=false

# Independent CMS SEO resolution: canonical public origin, HTTPS and no path.
CMS_PUBLIC_SITE_ORIGIN=

# Independent enquiry intake is off until migration, publication and ingress UAT.
CMS_ENQUIRY_ENABLED=false
# Attachment runtime remains unmounted until the complete intake flow is verified.
CMS_ENQUIRY_FILES_ENABLED=false
CMS_WEBSITE_ID=
CMS_SUPABASE_SERVICE_ROLE_KEY=
CMS_TURNSTILE_SECRET=
# Separate random secrets (at least 32 characters); never NEXT_PUBLIC variables.
CMS_ENQUIRY_INGRESS_SECRET=
CMS_ENQUIRY_IDENTITY_SECRET=
# Public widget site key for the matching Turnstile widget/action.
CMS_TURNSTILE_SITE_KEY=

# Independent trusted-validation queue consumer. Enable after migrations 001–031.
CMS_VALIDATION_WORKER_ENABLED=false
# Separate random URL-safe secret, 32–256 characters; used only by the scheduler.
CMS_VALIDATION_WORKER_SECRET=
# Read-only independent published content API; existing website source is unchanged.
CMS_PUBLIC_DELIVERY_ENABLED=false
# Public hero video delivery also requires published-homepage authorization.
CMS_PUBLIC_HERO_VIDEO_ENABLED=false
# Journal article routes and API. Keep disabled until listing integration, migration and publication checks pass.
CMS_JOURNAL_DELIVERY_ENABLED=false
# Specialists page composition, directory and SEO. Requires public delivery plus
# approved published page/profiles/settings and staging UAT. No legacy fallback.
CMS_SPECIALISTS_DELIVERY_ENABLED=false
# Enable only after all journey URLs, images, listings and SEO pass staging UAT.
# Requires CMS_PUBLIC_DELIVERY_ENABLED=true. Missing CMS records never fall back.
CMS_JOURNEY_RENDERING_ENABLED=false
# Individual destination detail pages only; country/atlas templates remain separate.
# Requires public delivery and complete destination migration/UAT. No missing-record fallback.
CMS_DESTINATION_RENDERING_ENABLED=false

# Opt-in published navigation. Requires migration 065 and an approved published menu.
CMS_NAVIGATION_DELIVERY_ENABLED=false
CMS_MAIN_NAVIGATION_ID=
# Opt-in shared settings footer; requires published settings and migrations 071–072.
CMS_FOOTER_DELIVERY_ENABLED=false
# Published branding/header settings override the standalone menu switch when enabled.
CMS_HEADER_SETTINGS_ENABLED=false
# Opt-in published announcement and floating CTA; requires migration 071.
CMS_MESSAGES_DELIVERY_ENABLED=false
# Opt-in published search controls; unsupported collections block rollout.
CMS_SEARCH_SETTINGS_ENABLED=false
# Published SEO defaults for migrated detail routes and sitemap. Keep off until sitewide migration is complete.
CMS_SEO_SETTINGS_ENABLED=false
# Published cookie wording. Analytics requires explicit consent regardless of this switch.
CMS_COOKIE_SETTINGS_ENABLED=false
# Published missing-page/server-error wording; recovery falls back when settings cannot load.
CMS_ERROR_SETTINGS_ENABLED=false
# Enable published maintenance interception only after deployment acceptance.
CMS_MAINTENANCE_ENABLED=false
# Published favicon/application identity and organization structured data.
CMS_BRAND_METADATA_ENABLED=false

# Worker-only absolute paths for hero-video processing. Upload/delivery wiring is pending.
# Configure on the isolated worker host; do not expose these as NEXT_PUBLIC settings.
CMS_FFMPEG_PATH=
CMS_FFPROBE_PATH=
# Optional absolute scratch-volume root for private per-job video directories.
CMS_VIDEO_TEMP_ROOT=
# Keep false until video transfer, scanning, workers and recovery are validated on the provider.
CMS_HERO_VIDEO_UPLOADS_ENABLED=false

# Site-scoped publish/withdraw delivery worker; configure a protected scheduler.
CMS_DELIVERY_WORKER_ENABLED=false
CMS_DELIVERY_WORKER_SECRET=
# Keep off until homepage publication, source fidelity and migration acceptance.
CMS_HOMEPAGE_DELIVERY_ENABLED=false

# PDF reservation/transfer scaffolding. Keep disabled until inspection and recovery are deployed.
CMS_DOCUMENT_UPLOADS_ENABLED=false
# Private PDF worker runtime; configure and verify in an isolated worker before enabling uploads.
CMS_PDF_PYTHON_PATH=
CMS_PDF_SCRIPT_PATH=
CMS_PDF_PARSER_VERSION=
CMS_PDF_TEMP_ROOT=

# Server-mediated published PDF downloads; keep disabled until document publication is verified.
CMS_DOCUMENT_DOWNLOADS_ENABLED=false

# Custom editorial pages: keep disabled until publication/provider acceptance.
CMS_CUSTOM_PAGES_ENABLED=false
# Approved custom-page URL aliases; requires custom pages and public delivery.
CMS_PAGE_REDIRECTS_ENABLED=false

# Conservation rollout: enable only after migration 162, source review and published content/SEO verification.
CMS_CONSERVATION_PAGE_ENABLED=false

# Enable published contact rendering only after migration 166, content/form review and delivery verification.
# Requires public delivery and fully configured enquiry intake. Keep disabled until rollout checks pass.
CMS_CONTACT_PAGE_ENABLED=false

# Enable only after Bespoke content/settings publication and database migrations 180–185.
CMS_GUIDED_DELIVERY_ENABLED=false

# Private Aviation: enable only after media, migration and publication acceptance.
# Requires public delivery, published SEO settings and database migrations through 193.
CMS_AVIATION_DELIVERY_ENABLED=false
# MICE route is connected; keep disabled until publication/provider/client acceptance.
CMS_MICE_DELIVERY_ENABLED=false

# Database-wide publication scheduler. Apply migration 196 and verify due-job execution first.
# Keep credentials server-only; configure authenticated timer calls separately.
CMS_SCHEDULE_WORKER_ENABLED=false
CMS_SCHEDULE_WORKER_SECRET=

# Group schedules require a host supporting a 300-second worker invocation.
CMS_RELEASE_SCHEDULE_WORKER_ENABLED=false
CMS_RELEASE_SCHEDULE_WORKER_SECRET=

# Kenya published-content loader. Keep disabled until release/website integration is accepted.
CMS_KENYA_DELIVERY_ENABLED=false

# Tanzania country delivery: enable only after staged release acceptance.
CMS_TANZANIA_DELIVERY_ENABLED=false

# Project public readers (keep disabled until publication and handover gates pass).
CMS_PROJECT_DELIVERY_ENABLED=false

# News visitor delivery requires the public delivery flag and staged release acceptance.
CMS_NEWS_DELIVERY_ENABLED=false

# Event visitor delivery (requires the global CMS rollout as well).
CMS_EVENTS_DELIVERY_ENABLED=false

# Leadership delivery remains opt-in until release acceptance.
CMS_LEADERSHIP_DELIVERY_ENABLED=false

# Application/industry visitor delivery stays off until its rollout is verified.
CMS_APPLICATION_DELIVERY_ENABLED=false

# Careers visitor delivery remains disabled until staging acceptance.
CMS_CAREER_DELIVERY_ENABLED=false

# Independent CMS notifications: keep disabled until routes and staged delivery are accepted.
# POST /api/cms/workers/notifications with Bearer CMS_NOTIFICATION_WORKER_SECRET.
# Requires a host supporting the 180-second endpoint duration. No scheduler is installed here.
CMS_NOTIFICATION_WORKER_ENABLED=false
# Separate gate for authorized setup checks; requires migrations through 404.
CMS_NOTIFICATION_PROBES_ENABLED=false
CMS_NOTIFICATION_WORKER_SECRET=
CMS_NOTIFICATION_RESEND_API_KEY=
CMS_NOTIFICATION_CMS_ORIGIN=

# Enable only after staged provider receipt verification and migration 390.
CMS_NOTIFICATION_RECONCILIATION_ENABLED=false
# Read-only provider verification for uncertain setup emails; requires migration 407.
CMS_NOTIFICATION_PROBE_RECONCILIATION_ENABLED=false

# Unique UUID per notification worker deployment; rotate when replacing its configuration.
CMS_NOTIFICATION_DEPLOYMENT_ID=

# Private enquiry attachment worker (keep disabled until deployment acceptance).
# ClamAV executable/signature database and PDF runtime must exist on the worker.
CMS_ENQUIRY_FILE_WORKER_ENABLED=false
CMS_ENQUIRY_FILE_WORKER_SECRET=
CMS_CLAMSCAN_PATH=
CMS_CLAMAV_DATABASE_DIRECTORY=
CMS_CLAMAV_TEMP_ROOT=

# Private retention cleanup worker. Keep disabled until approved policy and staging checks pass.
CMS_ENQUIRY_FILE_CLEANUP_ENABLED=false
CMS_ENQUIRY_FILE_CLEANUP_SECRET=

# Certification public delivery remains off until hosted acceptance.
CMS_CERTIFICATION_DELIVERY_ENABLED=false

# Independent partner visitor delivery (enable only after staging acceptance).
CMS_PARTNER_DELIVERY_ENABLED=false
CMS_PRODUCT_CATEGORY_DELIVERY_ENABLED=false
CMS_PRODUCT_DELIVERY_ENABLED=false
