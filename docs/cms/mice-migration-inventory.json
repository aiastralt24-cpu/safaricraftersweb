              "id": "format-1",
              "title": "Incentive travel",
              "copy": "Recognise employees, dealers, distributors and channel partners with incentive travel in India or overseas. Shape each reward journey around the achievement and the people behind it."
            },
            {
              "id": "format-2",
              "title": "Retreats, offsites & partner meets",
              "copy": "Bring employees, dealers or distributors together for a company offsite, leadership retreat or partner meet. Balance business conversations with shared experiences and time to recharge."
            },
            {
              "id": "format-3",
              "title": "Client hospitality & group travel",
              "copy": "Strengthen relationships through client hospitality, customer appreciation trips and corporate group travel. Plan around your guests’ interests, business objectives and preferred destinations."
            },
            {
              "id": "format-4",
              "title": "Wildlife & cultural experiences",
              "copy": "Connect employees, business partners and clients through safari experiences, photography and local culture. Choose activities that suit your guests’ interests, pace and access needs."
            }
