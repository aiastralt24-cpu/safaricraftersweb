          "paragraphs": [
            {
              "id": "paragraph-1",
              "text": "From dealer incentive trips in India to international client hospitality, a meaningful corporate journey begins with a clear purpose. Reward performance, build partner relationships, thank your clients or bring employees together."
            },
            {
              "id": "paragraph-2",
              "text": "Our corporate travel and MICE planning starts with your brief. Tell us what you want to achieve, and we’ll explore destinations, accommodation and experiences around your group’s priorities. You don’t need a finished itinerary to begin."
            }
          ],
          "button": {
            "label": "Plan a corporate journey",
            "href": "#corporate-enquiry"
          }
