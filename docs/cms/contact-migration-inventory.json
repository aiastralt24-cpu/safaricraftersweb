      "contactContent": {
        "intro": {
          "eyebrow": "A journey starts with a conversation",
          "heading": {
            "lines": [
              {
                "runs": [
                  {
                    "text": "Where would you",
                    "emphasis": false
                  }
                ]
              },
              {
                "runs": [
                  {
                    "text": "like to ",
                    "emphasis": false
                  },
                  {
                    "text": "go next?",
                    "emphasis": true
                  }
                ]
              }
            ]
          },
          "lead": "A place you’ve always imagined. A wildlife encounter you’ve waited for. Tell us what draws you there, and we’ll help shape the journey.",
          "scope": "Private journeys, bespoke safaris and photography tours across India and beyond.",
          "image": {
            "sourcePath": "/assets/destinations/kanha/field-photographs/8a6eba1b2e6a.webp",
