              "data": {
                "title": "How we use your personal data",
                "body": [
                  {
                    "kind": "paragraph",
                    "text": "We use personal data only where the law allows us to: perform a contract we are entering into or have entered into with you; pursue our legitimate interests or those of a third party where your rights do not override those interests; or comply with a legal or regulatory obligation."
                  },
                  {
                    "kind": "paragraph",
                    "text": "We generally rely on consent only for direct marketing by email or text. You may withdraw marketing consent at any time by contacting info@safaricrafters.in.",
