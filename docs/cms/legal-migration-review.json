                "body": [
                  {
                    "kind": "paragraph",
                    "text": "You may stop marketing messages by using the unsubscribe link in a message or emailing info@safaricrafters.in. Opting out does not affect personal data supplied in connection with a booking or other transaction.",
                    "spans": [
