              "data": {
                "title": "Our commitment to your privacy",
                "body": [
                  {
                    "kind": "paragraph",
                    "text": "Safari Crafters (referred to as the “Company”, “we”, “us” or “our”) respects your privacy and is committed to protecting your personal data. This notice explains how we look after your personal data when you visit our website, regardless of where you visit it from, or provide personal data to us by other means, including by telephone. It also explains your privacy rights and how the law protects you."
                  },
                  {
                    "kind": "paragraph",
                    "text": "This notice describes how we collect, manage and process personal data, including information you provide when purchasing travel arrangements. Please read it together with any other privacy or fair-processing notice supplied when we collect your data. Those notices supplement this policy and do not override it."
                  }
                ]
              }
            },
            {
              "id": "legal-15",
              "kind": "text",
              "controls": {
                "label": "Minors",
                "headingLevel": "h3",
                "width": "reading",
                "spacing": "compact"
              },
              "data": {
                "title": "Minors",
                "body": [
                  {
                    "kind": "paragraph",
                    "text": "This website is not intended for minors as defined by the Indian Contract Act, 1872. We collect information relating to children or minors only when an adult who is legally competent to enter into a contract makes a booking for them."
                  }
                ]
              }
            },
            {
              "id": "legal-17",
              "kind": "text",
              "controls": {
                "label": "Third-party links",
